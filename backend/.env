# ─── Application ──────────────────────────────────────────────
APP_NAME="VentureTwin"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT="development"   # development | staging | production

# ─── Server ───────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="22100912"
POSTGRES_DB="VentureTwin"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Derived connection string (override if you prefer)
DATABASE_URL="postgresql+psycopg2://postgres:22100912@localhost:5432/VentureTwin"

# ─── JWT / Security ───────────────────────────────────────────
SECRET_KEY="CHANGE_ME_use_openssl_rand_hex_32_output_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Email (optional, for future use) ─────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-smtp-password"
